  "repository": {
    "type": "git",
    "url": "git+https://github.com/6zev/oc-purge.git"
  },
  "homepage": "https://github.com/6zev/oc-purge#readme",
  "bugs": {
    "url": "https://github.com/6zev/oc-purge/issues"
  },
  "author": "6zev",
  "type": "module",
  "license": "Apache-2.0",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./prompt": "./src/prompt.js",
    "./patches": "./src/patches.js",
    "./scope": "./src/scope.js",
    "./rules": "./src/rules.js",
    "./evidence": "./src/evidence.js",
    "./retry": "./src/retry.js",
    "./capability": "./src/capability.js",
    "./observe": "./src/observe.js",
    "./refusal": "./src/refusal.js",
    "./selfcheck": "./src/selfcheck.js",
    "./replay": "./src/replay.js",
    "./fsx": "./src/fsx.js",
    "./shexec": "./src/shexec.js",
    "./compact": "./src/compact.js",
    "./package.json": "./package.json",
    "./legacy": "./legacy/server.js"
  },
  "files": [
    "src",
    "agents",
    "skills",
    "docs",
    "README.md",
    "LICENSE",
    "legacy"
  ],
  "keywords": [
    "opencode",
    "opencode-plugin",
    "prompt",
    "agent",
    "harness",
    "oc-purge"
  ],
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@opencode/plugin": "^2.0.0",
    "effect": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@opencode/plugin": {
      "optional": true
    }
  },
  "scripts": {
    "test": "node --import ./test/register-stubs.mjs --test test/*.test.mjs"
